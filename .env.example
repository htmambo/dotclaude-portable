# dotclaude-portable 配置文件模板
# 实际生效是仓库根 .env（被 .gitignore 屏蔽）
# 用 ./tools/configure.mjs 交互式生成，或手 cp 本文件为 .env 后填值

# ─── External Review 供应商（CLAUDE.md §"Provider resolution"） ───
# 取值：coding-bridge | kimi | codex
REVIEW_PROVIDER=coding-bridge

# ─── coding-bridge 后端（仅当 REVIEW_PROVIDER=coding-bridge 生效） ───
# 取值（与 mcp/coding-bridge/.../providers.py 对齐，共 8 家）：
#   xfyun-coding | xfyun-http | xfyun-websocket | volcengine-coding
#   qianfan-coding | opencode-go | sensenova | deepseek
CODING_BRIDGE_PROVIDER=xfyun-coding

# coding-bridge 通用 API key（上游推荐只设这一个；切换 provider 无需改 key）
CODING_BRIDGE_API_KEY=

# ─── provider 专属 KEY（可选回退；mcp 按 provider 的 key 优先级链匹配） ───
# 仅当 CODING_BRIDGE_API_KEY 为空时才按下列顺序回退：
#   xfyun-coding / xfyun-http → SPARK_API_PASSWORD → SPARK_API_KEY
#   xfyun-websocket           → SPARK_API_KEY（还需 SPARK_APP_ID / SPARK_API_SECRET）
#   volcengine-coding         → VOLCENGINE_API_KEY → ARK_API_KEY
#   qianfan-coding            → QIANFAN_API_KEY
#   opencode-go               → OPENCODE_API_KEY
#   sensenova                 → SENSENOVA_API_KEY
#   deepseek                  → DEEPSEEK_API_KEY
SPARK_API_KEY=
ARK_API_KEY=
