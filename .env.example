# dotclaude-portable 配置文件模板
# 实际生效是仓库根 .env（被 .gitignore 屏蔽）
# 用 ./tools/configure.mjs 交互式生成，或手 cp 本文件为 .env 后填值

# ─── External Review 供应商（CLAUDE.md §"Provider resolution"） ───
# 取值：coding-bridge | kimi | codex
REVIEW_PROVIDER=coding-bridge

# ─── coding-bridge 后端（仅当 REVIEW_PROVIDER=coding-bridge 生效） ───
# 取值：xfyun-coding | volcengine-coding
CODING_BRIDGE_PROVIDER=xfyun-coding
# coding-bridge 的 API key（xfyun / volcengine 共用此变量；mcp 内部按 provider 优先级匹配）
CODING_BRIDGE_API_KEY=

# ─── kimi fallback（CLAUDE.md fallback 链：coding-bridge → kimi） ───
KIMI_API_KEY=

# ─── codex 通用 chat MCP ───
CODEX_API_KEY=
